---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Page Not Found — POYARA" description="The requested POYARA page could not be found." noIndex={true}>
  <section class="page-header wrap missing-page">
    <p class="eyebrow">ERROR / 404</p>
    <h1>Out of frame.<br /><em>Not out of options.</em></h1>
    <p>This page isn't part of the current site. The studio's work and notes are still a good place to start.</p>
    <div class="inline-actions">
      <a class="primary-button" href={withBase()}>Back to home <span aria-hidden="true">→</span></a>
      <a class="text-link" href={withBase('work/')}>Explore work <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
