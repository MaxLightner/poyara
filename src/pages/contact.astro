---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Contact & Collaboration — POYARA" description="Contact founder Mohammad Mohammadzadeh about interactive 3D, digital prototyping and technical visualization with POYARA.">
  <section class="page-header wrap contact-header">
    <p class="eyebrow">CONTACT / 05</p>
    <h1>Start with a <em>problem.</em></h1>
    <p>Conversations about product experiments, interactive 3D, technical visualization and selected collaborations are welcome.</p>
  </section>
  <section class="section wrap case-grid">
    <div class="case-main">
      <h2>What makes a useful brief?</h2>
      <p class="body-large">Tell us what you're trying to explain, build or test—and who needs to use it. A rough brief is enough if it describes the challenge and the constraints honestly.</p>
      <ul class="feature-list"><li>The audience and the problem</li><li>The desired interactive or visual outcome</li><li>Technical constraints and available material</li><li>Any relevant deadline or stage of development</li></ul>
      <h2>Get in touch</h2>
      <p class="body-large">Write directly to Mohammad Mohammadzadeh, founder of POYARA. A short description of the problem, context and intended outcome is a good start.</p>
      <a class="primary-button" href="mailto:Lightnermax@gmail.com?subject=POYARA%20%E2%80%94%20Project%20enquiry">Email the founder <span aria-hidden="true">↗</span></a>
      <p class="contact-address"><a href="mailto:Lightnermax@gmail.com">Lightnermax@gmail.com</a></p>
      <div class="inline-actions"><a class="text-link" href="https://github.com/MaxLightner" target="_blank" rel="noopener noreferrer">Public GitHub profile <span aria-hidden="true">↗</span></a><a class="text-link" href={withBase('work/')}>View selected work <span aria-hidden="true">→</span></a></div>
    </div>
    <aside class="case-meta"><p class="eyebrow">CONTACT / GOOD FIT</p><div><span>Founder</span><strong>Mohammad Mohammadzadeh</strong></div><div><span>Interactive</span><strong>Real-time 3D & product demonstrations</strong></div><div><span>Experimental</span><strong>Scoped digital prototypes</strong></div><div><span>Explanatory</span><strong>Technical & scientific visualization</strong></div></aside>
  </section>
</BaseLayout>
