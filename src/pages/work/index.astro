---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { withBase } from '../../lib/paths';
const projects = (await getCollection('projects')).sort((a, b) => {
  const order = ['mizato', 'chido', 'kamcheh', 'industrial-pump-demo'];
  return order.indexOf(a.id) - order.indexOf(b.id);
});
---
<BaseLayout title="Selected Work — POYARA" description="Public interactive projects and evidence-based case studies from POYARA.">
  <section class="page-header wrap">
    <p class="eyebrow">SELECTED WORK / 01</p>
    <h1>Work you can <em>inspect.</em></h1>
    <p>Inspectable software, spatial and technical experiences. These public project notes explain the problem, the approach and what each working preview actually demonstrates.</p>
  </section>
  <section class="section wrap">
    <div class="project-grid-list work-project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
    <div class="work-footline"><p>These are public prototypes and demonstrations, not claims of commercial launch, client deployment or measured results.</p><a class="text-link" href={withBase('websites/')}>Looking for website design examples? Explore the website portfolio <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
