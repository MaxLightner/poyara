---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemVisual from '../components/SystemVisual.astro';
import { withBase } from '../lib/paths';
import { reels } from '../data/reels';
import '../styles/home.css';

const latestNotes = (await getCollection('insights'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
---
<BaseLayout
  title="POYARA — From Questions to Working Products"
  description="POYARA builds business websites, interactive digital products, spatial experiences and technical 3D demonstrations. See inspectable work and original product thinking."
>
  <div class="poy-pointer-ring" aria-hidden="true"><span></span></div>
  <div class="poy-pointer-dot" aria-hidden="true"></div>
  <section class="poy-hero wrap" aria-labelledby="home-title">
    <div class="poy-hero-copy">
      <p class="poy-kicker"><span class="poy-signal"></span> POYARA / INDEPENDENT PRODUCT STUDIO</p>
      <h1 id="home-title">Make the idea<br /><span>testable<span class="poy-dot">.</span></span></h1>
      <p class="poy-hero-lead">Websites that explain a business. Product prototypes people can test. Interactive 3D that makes complex things clear. Built by a small, independent AI-native studio.</p>
      <div class="poy-hero-actions">
        <a class="poy-button poy-button-solid" href={withBase('websites/')}>Explore website work <span aria-hidden="true">↗</span></a>
        <a class="poy-button poy-button-quiet" href={withBase('solutions/')}>What can we build? <span aria-hidden="true">↗</span></a>
      </div>
    </div>

    <div class="poy-stage" aria-label="An abstract illustration of a question becoming a working prototype">
      <div class="poy-stage-glow" aria-hidden="true"></div>
      <div class="poy-stage-grid" aria-hidden="true"></div>
      <div class="poy-stage-head"><span>POYARA / PROTOTYPE ENGINE</span><span>FIG—001</span></div>
      <svg class="poy-stage-lines" viewBox="0 0 650 550" fill="none" aria-hidden="true">
        <path class="poy-path poy-path-a" d="M58 126C143 126 133 265 249 265S385 155 505 155" />
        <path class="poy-path poy-path-b" d="M58 414C150 414 146 306 249 306S391 409 541 409" />
        <path class="poy-path poy-path-c" d="M249 265V306M505 155L562 155M541 409H588" />
        <circle class="poy-traveller" r="5"><animateMotion dur="7s" repeatCount="indefinite" path="M58 126C143 126 133 265 249 265S385 155 505 155" /></circle>
        <circle class="poy-traveller poy-traveller-two" r="4"><animateMotion dur="9s" repeatCount="indefinite" path="M58 414C150 414 146 306 249 306S391 409 541 409" /></circle>
      </svg>
      <div class="poy-stage-node poy-node-input"><span>01 / FRAME</span><strong>A question</strong><small>What needs to change?</small></div>
      <div class="poy-stage-core"><span>02 / BUILD</span><div class="poy-stage-core-symbol" aria-hidden="true"><i></i><i></i><i></i></div><strong>Working<br />prototype</strong><small>Not another slide deck.</small></div>
      <div class="poy-stage-node poy-node-output"><span>03 / LEARN</span><strong>Real feedback</strong><small>Observe. Decide. Refine.</small></div>
      <div class="poy-stage-foot"><span>IDEA → INTERACTION → EVIDENCE</span><span class="poy-stage-live"><i></i> IN MOTION</span></div>
    </div>
    <div class="poy-hero-bottom"><span>PRODUCT REASONING <b>·</b> AI-NATIVE BUILDING <b>·</b> INTERACTIVE TECHNOLOGY</span><a href="#selected-builds">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="poy-work-section" id="selected-builds" aria-labelledby="builds-heading">
    <div class="wrap">
      <div class="poy-section-heading" data-reveal>
        <div><p class="poy-kicker">01 / IN THE MAKING</p><h2 id="builds-heading">Less pitch.<br /><span>More proof.</span></h2></div>
        <p>Different industries, one approach: get to a working experience early. These are public previews of independently developed products—not claims of commercial launch.</p>
      </div>
      <div class="poy-products">
        <article class="poy-product poy-product-mizato" data-reveal>
          <div class="poy-product-copy">
            <div class="poy-product-top"><span>01 / HOSPITALITY</span><span>PUBLIC PREVIEW <i></i></span></div>
            <a class="poy-product-name" href={withBase('work/mizato/')}>MIZATO<span>↗</span></a>
            <h3>A better path from menu to order.</h3>
            <p>Digital menus, visual choices, and a connected ordering experience for restaurants and cafés.</p>
            <a href="https://mizato.ir/" target="_blank" rel="noopener noreferrer">Open public preview <span aria-hidden="true">↗</span></a>
          </div>
          <a class="poy-product-art poy-art-mizato" href={withBase('work/mizato/')} aria-label="View the Mizato project note">
            <span class="poy-art-orbit poy-art-orbit-one"></span>
            <span class="poy-art-orbit poy-art-orbit-two"></span>
            <div class="poy-art-order">
              <div class="poy-art-order-head"><span>TABLE / 07</span><span>● ● ●</span></div>
              <div class="poy-art-order-line"><b></b><span></span></div>
              <div class="poy-art-order-line"><b></b><span></span></div>
              <div class="poy-art-order-line"><b></b><span></span></div>
              <div class="poy-art-order-footer"><span>CHOOSE</span><span>→</span><span>ORDER</span></div>
            </div>
            <div class="poy-art-float">01 <span>→</span> 02 <span>→</span> 03</div>
          </a>
        </article>

        <article class="poy-product poy-product-chido" data-reveal>
          <div class="poy-product-copy">
            <div class="poy-product-top"><span>02 / SPATIAL TECH</span><span>PUBLIC DEMO <i></i></span></div>
            <a class="poy-product-name" href={withBase('work/chido/')}>CHIDO<span>↗</span></a>
            <h3>See the furniture in your space.</h3>
            <p>An augmented-reality experiment in product placement and spatial decision-making.</p>
            <a href="https://maxlightner.github.io/tolica-ar/" target="_blank" rel="noopener noreferrer">Open public demo <span aria-hidden="true">↗</span></a>
          </div>
          <a class="poy-product-art poy-art-chido" href={withBase('work/chido/')} aria-label="View the Chido project note">
            <div class="poy-art-floor"></div>
            <svg viewBox="0 0 440 290" class="poy-art-furniture" fill="none">
              <path d="M87 175L219 108L352 176L222 251Z" fill="#446678" fill-opacity=".38" stroke="#90C9D2" stroke-width="2" />
              <path d="M87 175V129L219 65L352 130V176L219 241L87 175Z" fill="#203D48" stroke="#BCE4DC" stroke-width="2" />
              <path d="M110 141L219 88L329 141L221 195Z" fill="#6B9DA0" stroke="#D4FBEC" stroke-width="2"/>
              <path d="M110 141V170L221 225V195M221 225L329 170V141" stroke="#A1C9C3" stroke-width="2"/>
              <path d="M76 195L210 264L366 189" stroke="#CAFFE8" stroke-dasharray="6 7" opacity=".8"/>
              <circle cx="219" cy="210" r="68" stroke="#C8FFED" stroke-dasharray="3 7" opacity=".6"/>
            </svg>
            <span class="poy-art-axis">X / Y / Z</span><span class="poy-art-target">+</span>
          </a>
        </article>

        <article class="poy-product poy-product-kamcheh" data-reveal>
          <div class="poy-product-copy">
            <div class="poy-product-top"><span>03 / CONSTRUCTION</span><span>PUBLIC BETA <i></i></span></div>
            <a class="poy-product-name" href={withBase('work/kamcheh/')}>KAMCHEH<span>↗</span></a>
            <h3>Connect the people who build.</h3>
            <p>A construction-focused marketplace prototype connecting specialists, work requests, and project evidence.</p>
            <a href="https://maxlightner.github.io/kamcheh/" target="_blank" rel="noopener noreferrer">Explore public beta <span aria-hidden="true">↗</span></a>
          </div>
          <a class="poy-product-art poy-art-kamcheh" href={withBase('work/kamcheh/')} aria-label="View the Kamcheh project note">
            <svg class="poy-art-blueprint" viewBox="0 0 450 290" fill="none">
              <path d="M62 225V76H186V119H305V57H394V225H62Z" stroke="#A5E4BD" stroke-width="3"/>
              <path d="M186 76V225M305 119V225M62 159H186M305 170H394M218 119V170H305" stroke="#6DAF93" stroke-width="2"/>
              <path d="M47 55V245M47 55H404M47 245H404" stroke="#A1D5B5" stroke-width="1" stroke-dasharray="4 8" opacity=".5"/>
              <circle cx="186" cy="159" r="9" fill="#C5FFE0"/><circle cx="305" cy="170" r="9" fill="#C5FFE0"/>
              <path d="M72 253H180M72 248V258M180 248V258M321 253H393M321 248V258M393 248V258" stroke="#C4E9CE"/>
            </svg>
            <span class="poy-art-coord">SITE / NETWORK / WORK</span>
          </a>
        </article>
      </div>
      <p class="poy-art-note">These are conceptual illustrations. Open a project note or the live preview to inspect the real interface.</p>
    </div>
  </section>

  <section class="poy-websites-feature wrap" aria-labelledby="home-websites-heading">
    <div class="poy-websites-head" data-reveal>
      <div><p class="poy-kicker">WEBSITE DESIGN / READY TO VIEW</p><h2 id="home-websites-heading">The web is part<br />of <span>the work.</span></h2></div>
      <div><p>From an architecture company’s website to a fictional luxury brand in motion. Real public links, different visual languages, and clear project stages.</p><a class="poy-button poy-button-outline" href={withBase('websites/')}>View all website examples <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="poy-websites-tiles" data-reveal>
      <a href="https://www.nikabana.ir/" target="_blank" rel="noopener noreferrer"><small>LIVE SITE / IN DEVELOPMENT</small><strong>NIKA BANA</strong><span>Architecture & construction ↗</span></a>
      <a href="https://mizato.ir/" target="_blank" rel="noopener noreferrer"><small>PUBLIC PRODUCT PREVIEW</small><strong>MIZATO</strong><span>Hospitality & ordering ↗</span></a>
      <a href="https://maxlightner.github.io/maison-velora-motion-lab/" target="_blank" rel="noopener noreferrer"><small>FICTIONAL MOTION CONCEPT</small><strong>MAISON VELORA</strong><span>Luxury editorial motion ↗</span></a>
    </div>
  </section>

  <section class="poy-process-section" id="approach" aria-labelledby="approach-heading">
    <div class="wrap">
      <div class="poy-process-intro" data-reveal><p class="poy-kicker">02 / THE WAY WE WORK</p><h2 id="approach-heading">The advantage isn't the tool.<br /><span>It's how we think.</span></h2><p>AI changes the cost of making software. It doesn't decide which problems matter, how an experience should work, or what evidence is enough to move forward. Those decisions are the studio's craft.</p></div>
      <div class="poy-process-rail">
        <article class="poy-step" data-reveal><span>01 / UNDERSTAND</span><h3>Frame the real problem.</h3><p>Map the constraint, the person, and the decision that needs to become easier.</p></article>
        <article class="poy-step" data-reveal><span>02 / MAKE</span><h3>Build what can be tested.</h3><p>Connect design, engineering, and visual thinking in a working prototype.</p></article>
        <article class="poy-step" data-reveal><span>03 / LEARN</span><h3>Let reality answer.</h3><p>Observe use, identify friction, and make the next product decision.</p></article>
      </div>
    </div>
  </section>

  <section class="poy-evidence-section wrap" aria-labelledby="evidence-heading">
    <div class="poy-evidence-copy" data-reveal>
      <p class="poy-kicker">03 / REAL-TIME EXPERIMENT</p>
      <h2 id="evidence-heading">Interaction is <span>evidence.</span></h2>
      <p>A working industrial-pump demo shows how complex equipment can be understood through real-time 3D, component inspection, and an exploded assembly.</p>
      <a class="poy-button poy-button-outline" href={withBase('work/industrial-pump-demo/')}>Inspect the case study <span aria-hidden="true">↗</span></a>
    </div>
    <div class="poy-evidence-visual" data-reveal><SystemVisual id="home-feature" compact /></div>
  </section>

  <section class="poy-founder-section" aria-labelledby="founder-heading">
    <div class="wrap poy-founder-inner">
      <div class="poy-founder-portrait" data-reveal><img src={withBase('founder.jpg')} alt="Mohammad Mohammadzadeh, founder of POYARA" width="400" height="400" loading="lazy" /></div>
      <div class="poy-founder-story" data-reveal>
        <p class="poy-kicker">04 / INDEPENDENT BY DESIGN</p>
        <h2 id="founder-heading">A maker's past.<br /><span>A product studio's future.</span></h2>
        <p>POYARA is led by Mohammad Mohammadzadeh. Fourteen-plus years in 3D and scientific visualization inform a newer practice: designing systems, testing product ideas, and building software with AI-native workflows.</p>
        <a class="poy-inline-link" href={withBase('about/')}>The story behind POYARA <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="poy-origin-section wrap" id="motion-work" aria-labelledby="reels-heading">
    <div class="poy-origin-head" data-reveal><div><p class="poy-kicker">05 / VISUAL ROOTS</p><h2 id="reels-heading">Before the products,<br /><span>there was the craft.</span></h2></div><p>Earlier medical, architectural, and real-time 3D work. A foundation in making complex things visible—not the entire story of the studio today.</p></div>
    <div class="poy-reels">
      {reels.map((reel, index) => (
        <article class="poy-reel" data-reveal>
          <button type="button" class="reel-play poy-reel-thumb" data-video-src={reel.video} data-video-title={reel.title} data-source-href={reel.url} aria-label={`Play ${reel.title}`}>
            <img src={reel.image} alt={`Preview of ${reel.title}`} loading="lazy" width="404" height="316" />
            <span class="poy-reel-play" aria-hidden="true">▶</span>
          </button>
          <div class="poy-reel-caption"><span>0{index + 1}</span><div><h3>{reel.title}</h3><p>{reel.category}</p></div><a href={reel.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${reel.title} on Behance`}>↗</a></div>
        </article>
      ))}
    </div>
    <a class="poy-inline-link poy-behance-link" href="https://www.behance.net/mohammad3d" target="_blank" rel="noopener noreferrer">Full early visual portfolio on Behance <span aria-hidden="true">↗</span></a>
  </section>

  {latestNotes.length > 0 && <section class="poy-note-section">
    <div class="wrap poy-note-inner" data-reveal>
      <div class="poy-note-intro"><p class="poy-kicker">06 / THINKING IN PUBLIC</p><h2>What building<br /><span>teaches us.</span></h2><p>Field notes on judgment, prototypes, AI agents and the friction between a working demo and a useful product.</p><a class="poy-inline-link" href={withBase('insights/')}>All studio insights <span aria-hidden="true">↗</span></a></div>
      <div class="poy-note-list">{latestNotes.map((note, i) => <a class="poy-note-entry" href={withBase(`insights/${note.id}/`)}><span>{String(i + 1).padStart(2,'0')} / {note.data.topic}</span><h3>{note.data.title}</h3><p>{note.data.summary}</p><span class="poy-note-arrow" aria-hidden="true">↗</span></a>)}</div>
    </div>
  </section>}

  <dialog class="reel-dialog" aria-label="Portfolio video player">
    <div class="reel-dialog-head"><span>POYARA / SELECTED MOTION</span><button type="button" class="reel-close" aria-label="Close video player">✕ CLOSE</button></div>
    <div class="reel-player"><iframe title="Portfolio film" src="about:blank" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><video hidden controls playsinline preload="none"></video></div>
    <div class="reel-dialog-foot"><span class="reel-dialog-title"></span><a target="_blank" rel="noopener noreferrer" href="https://www.behance.net/mohammad3d">Watch on Behance ↗</a></div>
  </dialog>
  <script>import '../home-motion.ts';</script>
</BaseLayout>
