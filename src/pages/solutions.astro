---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---
<BaseLayout title="Solutions & Capabilities — POYARA">
  <section class="page-header wrap">
    <p class="eyebrow">CAPABILITIES / 03</p>
    <h1>Build the <em>hard part.</em></h1>
    <p>Focused technical and creative collaboration grounded in experience rather than a catalogue of generic services.</p>
  </section>
  <section class="section wrap">
    <div class="capability-grid">
      <article><span class="eyebrow">01</span><h2>Interactive 3D & XR</h2><p>Real-time visualization, product demos and spatial experiences that make complex systems easier to explore.</p></article>
      <article><span class="eyebrow">02</span><h2>AI-native prototypes</h2><p>Purpose-built digital prototypes using modern development tools, automation and rapid iteration.</p></article>
      <article><span class="eyebrow">03</span><h2>Scientific visualization</h2><p>Visual storytelling informed by experience with medical and scientific animation workflows.</p></article>
    </div>
    <a class="text-link" href={withBase('work/')}>See public work <span aria-hidden="true">↗</span></a>
  </section>
</BaseLayout>
