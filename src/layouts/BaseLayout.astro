---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/paths';
import '../styles/global.css';
import '../styles/design.css';
const {
  title = 'POYARA — Independent AI-Native Product Studio',
  description = 'A founder-led studio building practical digital products through AI-native development and interactive technologies.',
  type = 'website',
  publishedTime,
  noIndex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const previewMode = import.meta.env.PUBLIC_SITE_INDEXABLE !== 'true';
const robots = previewMode ? 'noindex, nofollow' : noIndex ? 'noindex, follow' : 'index, follow';
const socialImage = new URL(withBase('og-card.png'), Astro.site ?? Astro.url.origin).href;
const home = canonical === new URL(withBase(), Astro.site ?? Astro.url.origin).href;
const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'POYARA',
  url: canonical,
  description,
  inLanguage: 'en'
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#070c0f" />
    {!noIndex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="POYARA" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="POYARA — complex ideas, tangible work. Independent AI-native product studio." />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {home && <script type="application/ld+json" set:html={websiteSchema} />}
    <script is:inline>document.documentElement.classList.add('js-enabled');</script>
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell"><Header /><main id="main"><slot /></main><Footer /></div>
    <script>import '../interaction.ts';</script>
  </body>
</html>
