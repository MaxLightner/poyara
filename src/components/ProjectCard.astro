---
import { withBase } from '../lib/paths';
import SystemVisual from './SystemVisual.astro';
const { project, index = 0 } = Astro.props;
---
<article class="project-card">
  <div class="project-topline">
    <span class="eyebrow">{String(index + 1).padStart(2, '0')} / {project.data.category} / {project.data.status ?? 'Demo'}</span>
    <span class="project-arrow" aria-hidden="true">↗</span>
  </div>
  <div class="project-art" aria-hidden="true">
    <SystemVisual id={`work-${project.id}`} compact />
  </div>
  <div class="project-info">
    <h3><a href={withBase(`work/${project.id}/`)}>{project.data.title}</a></h3>
    <p>{project.data.summary}</p>
    <a class="text-link" href={withBase(`work/${project.id}/`)}>View case study <span aria-hidden="true">↗</span></a>
  </div>
</article>
